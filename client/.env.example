# Flagsmith Client-Side Environment Key (found in Flagsmith Dashboard -> Environment Settings -> SDK Keys)
# Leave blank to run in local offline fallback mode with deterministic ?demo=true switching
VITE_FLAGSMITH_ENV_KEY=

# Optional: override Flagsmith API URL (for self-hosted Flagsmith instances)
# VITE_FLAGSMITH_API_URL=http://localhost:8000/api/v1/

# Optional: override backend API base URL in production (blank uses Vite dev proxy to http://localhost:3001)
VITE_API_BASE_URL=
