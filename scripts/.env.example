# Flagsmith Server-Side Environment Key (starts with "ser.")
# Found in Flagsmith Dashboard -> Environment Settings -> SDK Keys -> Server-side
FLAGSMITH_SERVER_KEY=

# Optional: override Flagsmith API / Events URL for self-hosted instances
# FLAGSMITH_API_URL=http://localhost:8000/api/v1/
# FLAGSMITH_EVENTS_URL=http://localhost:8000/api/

# REQUIRED: the simulator sends fabricated outcomes. Use a separate, non-production
# Flagsmith environment, then set this to "yes". Events are tagged simulated=true.
SIM_CONFIRM_SEPARATE_ENV=

# Number of unique simulated players (UUIDs)
SIM_USERS=300

# Concurrency for Flagsmith API calls
SIM_CONCURRENCY=10

# Simulated outcome probabilities per variant
PROB_SILENT_CAUGHT=0.34
PROB_SILENT_FALSE_ACCUSE=0.14
PROB_SILENT_ABANDON=0.16
PROB_SILENT_PLAY_AGAIN=0.42

PROB_TELLS_CAUGHT=0.62
PROB_TELLS_FALSE_ACCUSE=0.12
PROB_TELLS_ABANDON=0.09
PROB_TELLS_PLAY_AGAIN=0.64
